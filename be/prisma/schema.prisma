// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  nama     String
}

model UserCareer {
  id      String   @id @default(uuid())
  tanggal DateTime
  nama    String
  no_hp   String
  email   String
  cv_link String
}

model Promo {
  id               String   @id @default(uuid())
  title            String
  subtitle         String
  description      String
  syaratKetentuan  String
  berlakuHingga    DateTime
  brandId          String
  brand            Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  image            String
}

model Brand {
  id          String @id @default(uuid())
  nama        String
  logo        String
  description String
  promos      Promo[]
  outlets     Outlet[]
}

model Berita {
  id          String   @id @default(uuid())
  judul       String
  image       String
  createdDate DateTime
  penulis     String
  content     String
}

model Outlet {
  id             String   @id @default(uuid())
  brandId        String
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  kota           String
  jamOperasional String
  lokasi         String
  image          String
  googleMapsLink String
  whatsappUrl    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Team {
  id            String   @id @default(uuid())
  nama          String
  title         String
  image         String
  linkedinUrl   String
  instagramUrl  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
